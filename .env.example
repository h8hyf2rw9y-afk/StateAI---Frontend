# Base URL of the future FastAPI backend.
# The frontend talks to this backend only through the API client in lib/api/ —
# never hardcode this URL elsewhere in the app.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and publishable (browser-safe) key — see README.md
# "Supabase configuration" for exactly where to find these in the dashboard.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY accepts either your project's
# "publishable key" (Supabase's current name for it) or its "anon key"
# (the older name for the same kind of key) — never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# Do NOT add a Supabase service_role key, OpenAI/Anthropic keys, or any
# other secret here. This file is committed to git — it must only ever
# contain non-secret, NEXT_PUBLIC_-safe defaults. Your real Supabase values
# go in .env.local (gitignored), never here. Backend-only secrets belong in
# the backend's own environment, never in the frontend at all.
# ---------------------------------------------------------------------------
